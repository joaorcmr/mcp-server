# ---------------------------------------------------------------------------
# Chat API (usada pelo MVP `send_message_to_botpress`)
# Conversa com o bot: enviar mensagens e receber respostas.
# O webhook ID vem da configuração da "Chat Integration" do seu bot no Botpress.
# Ex.: se a URL do webhook for https://chat.botpress.cloud/abc-123-def,
# então BOTPRESS_WEBHOOK_ID=abc-123-def
# ---------------------------------------------------------------------------
BOTPRESS_WEBHOOK_ID=
# Opcional: sobrescreve a base da Chat API (padrão: https://chat.botpress.cloud)
BOTPRESS_CHAT_API_URL=

# ---------------------------------------------------------------------------
# Management / Client API (usada pelas PRÓXIMAS tools: tables, KBs, bot info...)
# Ainda não usada pelo MVP, mas já preparada.
# BOTPRESS_TOKEN  -> Personal Access Token (PAT) gerado no Botpress Cloud.
# ---------------------------------------------------------------------------
BOTPRESS_TOKEN=
BOTPRESS_BOT_ID=
BOTPRESS_WORKSPACE_ID=
# Opcional: sobrescreve a base da Management API (padrão: https://api.botpress.cloud)
BOTPRESS_API_BASE_URL=
