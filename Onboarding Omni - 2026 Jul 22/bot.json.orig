        },
        {
          "type": "standard",
          "deletable": true,
          "x": 1935,
          "y": -45,
          "instructions": [
            {
              "id": "ins-01c94162cb",
              "category": "Send Messages",
              "type": "content",
              "label": "text",
              "content": {
                "type": "text",
                "text": {
                  "valueType": "dynamic",
                  "dynamicValue": "O que poderíamos fazer para tornar sua experiência melhor?",
                  "staticValue": ""
                },
                "typing": {
                  "valueType": "static",
                  "staticValue": true
                }
              },
              "nodeId": "nd-d9d83bf88b",
              "transitions": []
            },
            {
              "id": "ins-e5a670e556",
              "type": "wait",
              "category": "Capture Information",
              "label": "Wait for User Input",
              "description": "This card will wait for the user to send a message before continuing to the next card. It does not validate or manipulate the user input. You can access the user input in the next card using the `{{event.preview}}` variable.",
              "nodeId": "nd-d9d83bf88b",
              "transitions": []
            },
            {
              "id": "ins-970348326e",
              "type": "action",
              "category": "Execute",
              "code": "// Verifica se há alguma mensagem no event.preview para evitar salvar linhas vazias\r\nif (event.preview) {\r\n  \r\n  // 1. Limpeza do input: Mantém o texto livre, removendo apenas espaços extras nas pontas\r\n  const dadoLimpo = event.preview.trim();\r\n\r\n  // 2. CAPTURA DO TELEFONE REAL (Seu método para buscar como string)\r\n  const userNumber =\r\n    event.tags?.conversation?.['whatsapp:userPhone'] || \r\n    event.payload?.from || \r\n    event.payload?.contacts?.[0]?.wa_id ||\r\n    null;\r\n\r\n  // Verifica se, após a limpeza, ainda restou algo e se o telefone foi capturado com sucesso\r\n  if (dadoLimpo && userNumber) {\r\n    try {\r\n      // 3. Busca na tabela se já existe uma linha com o telefone desse usuário\r\n      const busca = await NPSTable.findRecords({\r\n        filter: { telefone: userNumber }\r\n      });\r\n\r\n      // Se encontrou algum registro para esse número...\r\n      if (busca && busca.length > 0) {\r\n        \r\n        // Pega o ID do último registro encontrado para este telefone (o mais recente)\r\n        const registroId = busca[busca.length - 1].id;\r\n\r\n        // 4. Atualiza a linha existente inserindo a resposta da pergunta_5\r\n        await NPSTable.updateRecord(registroId, {\r\n          pergunta_5: dadoLimpo\r\n        });\r\n        \r\n        console.log(\"✅ Sucesso: Registro atualizado com a pergunta 5 (texto livre). Telefone:\", userNumber);\r\n        \r\n      } else {\r\n        // Fallback: Se por algum motivo não encontrar a linha anterior, cria uma nova\r\n        console.log(\"Aviso: Nenhum registro anterior encontrado para atualizar. Criando um novo para:\", userNumber);\r\n        await NPSTable.createRecord({\r\n          telefone: userNumber,\r\n          pergunta_5: dadoLimpo\r\n        });\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Erro ao tentar buscar ou atualizar a NPSTable: \", error);\r\n    }\r\n    \r\n  } else {\r\n    // Avisos detalhados caso falte o dado ou o telefone\r\n    if (!userNumber) {\r\n      console.log(\"Aviso: Telefone não encontrado no payload. Busca no banco cancelada.\");\r\n    }\r\n    if (!dadoLimpo) {\r\n      console.log(\"Aviso: A mensagem estava vazia ou continha apenas espaços em branco.\");\r\n    }\r\n  }\r\n  \r\n} else {\r\n  console.log(\"Aviso: Nenhuma mensagem de texto encontrada em event.preview para salvar no NPS.\");\r\n}",
              "origin": "builtin",
              "label": "Salvando feedback",
              "nodeId": "nd-d9d83bf88b",
              "isCustomLabel": true,
              "transpiledCode": "var __defProp = Object.defineProperty;\nvar __name = (target, value) => __defProp(target, \"name\", { value, configurable: true });\nasync function __ROOT__() {\n  if (event.preview) {\n    const dadoLimpo = event.preview.trim();\n    const userNumber = event.tags?.conversation?.[\"whatsapp:userPhone\"] || event.payload?.from || event.payload?.contacts?.[0]?.wa_id || null;\n    if (dadoLimpo && userNumber) {\n      try {\n        const busca = await NPSTable.findRecords({\n          filter: { telefone: userNumber }\n        });\n        if (busca && busca.length > 0) {\n          const registroId = busca[busca.length - 1].id;\n          await NPSTable.updateRecord(registroId, {\n            pergunta_5: dadoLimpo\n          });\n          console.log(\"\\u2705 Sucesso: Registro atualizado com a pergunta 5 (texto livre). Telefone:\", userNumber);\n        } else {\n          console.log(\"Aviso: Nenhum registro anterior encontrado para atualizar. Criando um novo para:\", userNumber);\n          await NPSTable.createRecord({\n            telefone: userNumber,\n            pergunta_5: dadoLimpo\n          });\n        }\n      } catch (error) {\n        console.error(\"Erro ao tentar buscar ou atualizar a NPSTable: \", error);\n      }\n    } else {\n      if (!userNumber) {\n        console.log(\"Aviso: Telefone n\\xE3o encontrado no payload. Busca no banco cancelada.\");\n      }\n      if (!dadoLimpo) {\n        console.log(\"Aviso: A mensagem estava vazia ou continha apenas espa\\xE7os em branco.\");\n      }\n    }\n  } else {\n    console.log(\"Aviso: Nenhuma mensagem de texto encontrada em event.preview para salvar no NPS.\");\n  }\n  ;\n}\n__name(__ROOT__, \"__ROOT__\");\n; return await __ROOT__();",
