              ],
              "prompt": {
                "messages": [
                  {
                    "role": "system",
                    "content": "You are ExtractGPT and your only goal is to generate useful content in JSON format for developers to parse and use. You don't know any other language than JSON."
                  },
                  {
                    "role": "user",
                    "content": "```typescript\n/** The user answer to the question \"Which one would you like? Choices: [ 1) Red Apple, 2) Yellow Apple, 3) Dark Banana ]\" */\ninterface Output = { choice: {{CHOICES_TYPINGS}} }\n```\n\nHere is a conversation between me and a user. Transcript:\n\"\"\"\n(...)\nagent: Which one would you like? Choices: [ 1) Red Apple, 2) Yellow Apple, 3) Dark Banana ]\nuser: I will go with the second one please\n\"\"\""
                  },
                  {
                    "role": "assistant",
                    "content": "{\"choice\":\"Yellow Apple\"}"
                  },
                  {
                    "role": "user",
                    "content": "The previous transcripts were just examples, don't consider those as valid transcripts for this below task.\n\nThe current Date is {{CURRENT_DATE_TIME}}.\n\nAt this point of the conversation, I need require the user to fill the output in following JSON output to complete the task.\nIf more than one property, try to extract each of them the best you can.\n\n```typescript\n/** The user answer to the question \"{{QUESTION}}\" */\ninterface Output = { choice: {{CHOICES_TYPINGS}} }\n```\n\nHere is a conversation between me and a user. Transcript:\n\"\"\"\n(...)\n{{TRANSCRIPT}}\n\"\"\"\n\nIn the last user message, here are the entities found:\n\"\"\"\n{{ENTITIES_IDENTIFIED}}\n\"\"\"\n\nI need you to extract from the conversation transcript above the values the user has provided.\nIf the user has not provided the information I need, I need you to set the value of the missing answer properties to null.\nHave some tolerance to typos and variations in how the user selects from the possible values.\nUse your best judgement to provide the most accurate answer. In general, you can assume the user is cooperative and provides the information asked.\n\n\n\nNow, please reply to me with the above JSON output and nothing but JSON.\nYou should not explain your answer and should not talk back to me. Just JSON."
                  }
                ],
                "model": "fast-model",
                "temperature": 0
              }
            },
            {
              "id": "ins-a09c3ab477",
              "type": "action",
              "category": "Execute",
              "code": "// Verifica se há alguma mensagem no event.preview para evitar salvar linhas vazias\r\nif (event.preview) {\r\n  \r\n  // 1. Limpeza do input (Mantém 1 caractere alfanumérico)\r\n  const dadoLimpo = event.preview\r\n    .replace(/[^\\w]/gi, '') \r\n    .trim()                 \r\n    .charAt(0);             \r\n\r\n  // 2. CAPTURA DO TELEFONE REAL (Seu método para buscar como string)\r\n  const userNumber =\r\n    event.tags?.conversation?.['whatsapp:userPhone'] || \r\n    event.payload?.from || \r\n    event.payload?.contacts?.[0]?.wa_id ||\r\n    null;\r\n\r\n  // Verifica se restou um dado válido e se o telefone foi capturado\r\n  if (dadoLimpo && userNumber) {\r\n    try {\r\n      // 3. Busca na tabela se já existe uma linha com o telefone desse usuário\r\n      const busca = await NPSTable.findRecords({\r\n        filter: { telefone: userNumber }\r\n      });\r\n\r\n      // Se encontrou algum registro para esse número...\r\n      if (busca && busca.length > 0) {\r\n        \r\n        // Pega o ID do último registro encontrado para este telefone (o mais recente)\r\n        const registroId = busca[busca.length - 1].id;\r\n\r\n        // 4. Atualiza a linha existente inserindo a resposta da pergunta_2\r\n        await NPSTable.updateRecord(registroId, {\r\n          pergunta_4: dadoLimpo\r\n        });\r\n        \r\n        console.log(\"✅ Sucesso: Registro atualizado com a pergunta 4. Telefone:\", userNumber);\r\n        \r\n      } else {\r\n        // Fallback: Se não encontrar a linha da pergunta 1, cria uma nova\r\n        console.log(\"Aviso: Nenhum registro anterior encontrado para atualizar. Criando um novo para:\", userNumber);\r\n        await NPSTable.createRecord({\r\n          telefone: userNumber,\r\n          pergunta_4: dadoLimpo\r\n        });\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Erro ao tentar buscar ou atualizar a NPSTable: \", error);\r\n    }\r\n    \r\n  } else {\r\n    // Avisos detalhados caso falte o dado ou o telefone\r\n    if (!userNumber) {\r\n      console.log(\"Aviso: Telefone não encontrado no payload. Busca no banco cancelada.\");\r\n    }\r\n    if (!dadoLimpo) {\r\n      console.log(\"Aviso: O texto continha apenas símbolos ou emojis e resultou em vazio.\");\r\n    }\r\n  }\r\n  \r\n} else {\r\n  console.log(\"Aviso: Nenhuma mensagem de texto encontrada em event.preview para salvar no NPS.\");\r\n}",
              "origin": "builtin",
              "label": "Salvando feedback",
              "nodeId": "nd-5b56c5f0a7",
              "isCustomLabel": true,
              "transpiledCode": "var __defProp = Object.defineProperty;\nvar __name = (target, value) => __defProp(target, \"name\", { value, configurable: true });\nasync function __ROOT__() {\n  if (event.preview) {\n    const dadoLimpo = event.preview.replace(/[^\\w]/gi, \"\").trim().charAt(0);\n    const userNumber = event.tags?.conversation?.[\"whatsapp:userPhone\"] || event.payload?.from || event.payload?.contacts?.[0]?.wa_id || null;\n    if (dadoLimpo && userNumber) {\n      try {\n        const busca = await NPSTable.findRecords({\n          filter: { telefone: userNumber }\n        });\n        if (busca && busca.length > 0) {\n          const registroId = busca[busca.length - 1].id;\n          await NPSTable.updateRecord(registroId, {\n            pergunta_4: dadoLimpo\n          });\n          console.log(\"\\u2705 Sucesso: Registro atualizado com a pergunta 4. Telefone:\", userNumber);\n        } else {\n          console.log(\"Aviso: Nenhum registro anterior encontrado para atualizar. Criando um novo para:\", userNumber);\n          await NPSTable.createRecord({\n            telefone: userNumber,\n            pergunta_4: dadoLimpo\n          });\n        }\n      } catch (error) {\n        console.error(\"Erro ao tentar buscar ou atualizar a NPSTable: \", error);\n      }\n    } else {\n      if (!userNumber) {\n        console.log(\"Aviso: Telefone n\\xE3o encontrado no payload. Busca no banco cancelada.\");\n      }\n      if (!dadoLimpo) {\n        console.log(\"Aviso: O texto continha apenas s\\xEDmbolos ou emojis e resultou em vazio.\");\n      }\n    }\n  } else {\n    console.log(\"Aviso: Nenhuma mensagem de texto encontrada em event.preview para salvar no NPS.\");\n  }\n  ;\n}\n__name(__ROOT__, \"__ROOT__\");\n; return await __ROOT__();",
              "transitions": []
            }
          ],
