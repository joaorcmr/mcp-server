              "code": "/**\r\n * Captura a primeira mensagem do usuário de forma robusta.\r\n * Inclui validação de tipos, tratamento de erros e logs de auditoria.\r\n */\r\n\r\ntry {\r\n  // LOG: Início da execução do bloco\r\n  console.log(\"--- [DEBUG] Iniciando captura de First User Message ---\");\r\n\r\n  // 1. Validação de Segurança: Checa se os objetos principais existem\r\n  if (typeof conversation === 'undefined' || typeof event === 'undefined') {\r\n    console.warn(\"[WARN] Objetos 'conversation' ou 'event' não estão definidos. Script abortado.\");\r\n  } \r\n  // 2. Verifica se a variável JÁ foi preenchida anteriormente\r\n  else if (conversation.first_user_message) {\r\n    console.log(`[INFO] A variável já possui valor. Mantendo anterior: \"${conversation.first_user_message}\"`);\r\n  } \r\n  // 3. Verifica o tipo do evento e conteúdo\r\n  else if (event.type === 'text' && typeof event.preview === 'string') {\r\n    \r\n    const rawText = event.preview;\r\n    const cleanText = rawText.trim();\r\n\r\n    if (cleanText.length > 0) {\r\n      // --- AÇÃO PRINCIPAL: SALVAR ---\r\n      conversation.first_user_message = cleanText;\r\n      \r\n      // LOG: Sucesso com detalhe do que foi salvo\r\n      console.log(`[SUCCESS] Variável atualizada com sucesso!`);\r\n      console.log(`   > Texto Original: \"${rawText}\"`);\r\n      console.log(`   > Texto Salvo (Trimmed): \"${conversation.first_user_message}\"`);\r\n    } else {\r\n      console.log(\"[IGNORED] A mensagem recebida contém apenas espaços em branco.\");\r\n    }\r\n    \r\n  } else {\r\n    // LOG: Motivo de ignorar (não é texto ou formato inválido)\r\n    console.log(`[IGNORED] Evento ignorado. Tipo: ${event.type} | Preview válido: ${typeof event.preview === 'string'}`);\r\n  }\r\n\r\n} catch (error) {\r\n  // 4. Tratamento de Erros Críticos\r\n  console.error(\"[ERROR] Falha crítica ao capturar mensagem do usuário:\", error.message);\r\n}",
