        {
          "type": "autonomous",
          "deletable": true,
          "x": -360,
          "y": 345,
          "instructions": [
            {
              "type": "autonomous",
              "toolType": "transition",
              "condition": {
                "valueType": "dynamic",
                "dynamicValue": "workflow.result === 'success' || state.protocol_resolved === true",
                "staticValue": ""
              },
              "id": "ins-953155d9b5",
              "category": "Flow Logic",
              "label": "Transition",
              "destination": {
                "node": "nd-09113711ea"
              },
              "nodeId": "nd-7735f24d1c",
              "guidelines": {
                "valueType": "dynamic",
                "dynamicValue": "Quando o agente identificar que o Onboarding terminou totalmente com sucesso ou se o usuário pediu para finalizar a conversa"
              },
              "manualFields": [],
