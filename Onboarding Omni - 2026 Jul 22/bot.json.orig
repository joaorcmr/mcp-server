              "transpiledCode": "var __defProp = Object.defineProperty;\nvar __name = (target, value) => __defProp(target, \"name\", { value, configurable: true });\nasync function __ROOT__() {\n  try {\n    console.log(\"--- [DEBUG] Iniciando captura de First User Message ---\");\n    if (typeof conversation === \"undefined\" || typeof event === \"undefined\") {\n      console.warn(\"[WARN] Objetos 'conversation' ou 'event' n\\xE3o est\\xE3o definidos. Script abortado.\");\n    } else if (conversation.first_user_message) {\n      console.log(`[INFO] A vari\\xE1vel j\\xE1 possui valor. Mantendo anterior: \"${conversation.first_user_message}\"`);\n    } else if (event.type === \"text\" && typeof event.preview === \"string\") {\n      const rawText = event.preview;\n      const cleanText = rawText.trim();\n      if (cleanText.length > 0) {\n        conversation.first_user_message = cleanText;\n        console.log(`[SUCCESS] Vari\\xE1vel atualizada com sucesso!`);\n        console.log(`   > Texto Original: \"${rawText}\"`);\n        console.log(`   > Texto Salvo (Trimmed): \"${conversation.first_user_message}\"`);\n      } else {\n        console.log(\"[IGNORED] A mensagem recebida cont\\xE9m apenas espa\\xE7os em branco.\");\n      }\n    } else {\n      console.log(`[IGNORED] Evento ignorado. Tipo: ${event.type} | Preview v\\xE1lido: ${typeof event.preview === \"string\"}`);\n    }\n  } catch (error) {\n    console.error(\"[ERROR] Falha cr\\xEDtica ao capturar mensagem do usu\\xE1rio:\", error.message);\n  }\n  ;\n}\n__name(__ROOT__, \"__ROOT__\");\n; return await __ROOT__();",
