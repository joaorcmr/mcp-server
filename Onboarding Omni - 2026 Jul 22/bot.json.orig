                "staticValue": ""
              },
              "id": "ins-ce2277db63",
              "category": "Flow Logic",
              "label": "Transition",
              "destination": {
                "node": "nd-09113711ea"
              },
              "nodeId": "nd-93c605964c",
              "guidelines": {
                "valueType": "dynamic",
                "dynamicValue": "Quando o agente identificar que o Onboarding terminou totalmente com sucesso ou se o usuário pediu para finalizar a conversa"
              },
              "manualFields": [],
